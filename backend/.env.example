PORT=5000
# Browsers allowed to call this API (comma-separated). Include every frontend origin you use.
CLIENT_URLS=http://localhost:5173,https://sharebite.vercel.app
# Optional: single legacy var — merged into the list if not already present
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
JWT_SECRET=replace-with-a-long-random-secret
