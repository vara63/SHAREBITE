# API base: omit in dev to use localhost:5000; omit in prod build to use Railway URL.
# Or pin any URL for preview/staging:
# VITE_API_URL=https://sharebite-production.up.railway.app

# Reference URLs (used in src/env.ts defaults; override if your deploy differs)
VITE_APP_URL_LOCAL=http://localhost:5173
VITE_APP_URL_DEPLOYED=https://sharebite.vercel.app
VITE_API_URL_LOCAL=http://localhost:5000
VITE_API_URL_DEPLOYED=https://sharebite-production.up.railway.app
